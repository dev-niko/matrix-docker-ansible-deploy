#jinja2: lstrip_blocks: True
[Unit]
Description=Matrix strauby bot
{% for service in matrix_bot_matrix_strauby_bot_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in matrix_bot_matrix_strauby_bot_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} matrix-bot-matrix-strauby-bot 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm matrix-bot-matrix-strauby-bot 2>/dev/null || true'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
			--rm \
			--name=matrix-bot-matrix-strauby-bot \
			--log-driver=none \
			--user={{ matrix_user_uid }}:{{ matrix_user_gid }} \
			--cap-drop=ALL \
			--read-only \
			--network={{ matrix_bot_matrix_strauby_bot_container_network }} \
			-e 'TZ={{ matrix_bot_matrix_strauby_bot_timezone }}' \
			--mount type=bind,src={{ matrix_bot_matrix_strauby_bot_config_path }},dst=/config,ro \
			--mount type=bind,src={{ matrix_bot_matrix_strauby_bot_data_path }},dst=/data \
			--entrypoint=/bin/sh \
			{% for arg in matrix_bot_matrix_strauby_bot_container_extra_arguments %}
			{{ arg }} \
			{% endfor %}
			{{ matrix_bot_matrix_strauby_bot_container_image }} \
			-c "matrix-strauby-bot /config/config.yaml"

{% for network in matrix_bot_matrix_strauby_bot_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} matrix-bot-matrix-strauby-bot
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach matrix-bot-matrix-strauby-bot

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} matrix-bot-matrix-strauby-bot 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm matrix-bot-matrix-strauby-bot 2>/dev/null || true'
Restart=always
RestartSec=30
SyslogIdentifier=matrix-bot-matrix-strauby-bot

[Install]
WantedBy=multi-user.target
